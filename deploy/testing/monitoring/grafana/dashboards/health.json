{
 "uid": "msp-health",
 "title": "MSP Growth Engine: health",
 "tags": [
  "msp"
 ],
 "timezone": "utc",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Service",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Requests per second by status",
   "description": "",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code) (rate(msp_http_requests_total[5m]))",
     "legendFormat": "{{code}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "API p95 latency",
   "description": "Target: p95 below 500 ms for ordinary routes",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(msp_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(msp_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Slowest routes (p95)",
   "description": "",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(msp_http_request_duration_seconds_bucket[15m]))))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Database pool use",
   "description": "",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "msp_db_pool_acquired_connections / msp_db_pool_max_connections",
     "legendFormat": "{{job}} {{pool}}"
    }
   ]
  },
