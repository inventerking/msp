{
  "name": "msp-growth-engine",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:client": "pnpm --filter @msp/client dev",
    "dev:admin": "pnpm --filter @msp/admin dev",
    "gen:api": "pnpm --filter @msp/types gen",
    "build": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && depcruise apps packages --config .dependency-cruiser.cjs && spectral lint api/openapi/*.yaml api/openapi/modules/*.yaml --ruleset .spectral.yaml --fail-severity error",
    "e2e": "pnpm --filter @msp/e2e e2e"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.17.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "module"
}
