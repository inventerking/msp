# Local development defaults. Copy to .env. Never use these values on a shared server.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8088
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=msp_engine
DB_OWNER_PASSWORD=dev_owner
DB_APP_PASSWORD=dev_app
DB_PLATFORM_PASSWORD=dev_platform
DB_SYSTEM_PASSWORD=dev_system
REDIS_ADDR=127.0.0.1:56379
SMTP_ADDR=127.0.0.1:51025
MAIL_FROM=no-reply@msp-engine.test
# Sign-in requests allowed per IP per minute. Keep the default outside automated tests.
AUTH_RATE_PER_MINUTE=30
APP_BASE_URL=http://localhost:5180
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_ME
HMAC_KEY=REPLACE_ME

# File storage (local SeaweedFS), PDF rendering and malware scanning.
S3_ENDPOINT=http://127.0.0.1:58333
S3_BUCKET=msp-files
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key
GOTENBERG_URL=http://127.0.0.1:58300
# clamav needs: docker compose --profile scan up -d, and CLAMAV_ADDR=127.0.0.1:53310.
# allow-all marks files clean without scanning, and is refused outside local development.
FILE_SCANNER=allow-all
CLAMAV_ADDR=

# Competitor research: "fake" reads canned pages; "live" fetches real public websites through the Egress Guard.
# Keep it fake until legal review approves real research.
RESEARCH_FETCHER=fake
